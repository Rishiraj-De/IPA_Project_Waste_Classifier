# ==============================================================================
# AI Smart Waste Classification & Segregation System — Environment Configuration
# ==============================================================================

# API Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./waste_classifier.db
# DATABASE_URL=postgresql://user:password@localhost:5432/waste_classifier

# Computer Vision & Inference Settings
CONFIDENCE_THRESHOLD=0.50
MODEL_WEIGHTS_PATH=./ml/models/waste_yolov8_best.pt
FALLBACK_MODEL_NAME=yolov8n.pt
ENABLE_IMAGE_ENHANCEMENT=True

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
